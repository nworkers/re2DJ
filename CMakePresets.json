{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86-debug",
      "displayName": "Windows x86 Debug (primary native host)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows-x86",
      "cacheVariables": {
        "RE2DJ_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (MSVC)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "RE2DJ_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-ninja",
      "displayName": "Windows x64 (Ninja, single config)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RE2DJ_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x86-native-probe",
      "displayName": "Windows x86 Native Helper Probe (MSVC)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows-x86-native-probe",
      "cacheVariables": {
        "RE2DJ_BUILD_TESTS": "OFF",
        "RE2DJ_BUILD_NATIVE_HELPER_PROBE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x86-64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RE2DJ_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x86-64 Release",
      "inherits": "linux-x64-debug",
      "binaryDir": "${sourceDir}/build/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x86-native-probe",
      "displayName": "Linux i386 Native Helper Probe",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x86-native-probe",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32",
        "RE2DJ_BUILD_TESTS": "OFF",
        "RE2DJ_BUILD_LINUX_NATIVE_HELPER_PROBE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "RE2DJ_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-ninja",
      "configurePreset": "windows-x64-ninja"
    },
    {
      "name": "windows-x86-native-probe",
      "configurePreset": "windows-x86-native-probe",
      "configuration": "Debug",
      "targets": ["re2dj_native_helper_probe", "re2dj_native_ipc_helper", "re2dj_windows_injected_runtime"]
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "linux-x86-native-probe",
      "configurePreset": "linux-x86-native-probe",
      "targets": ["re2dj_linux_native_ipc_helper_probe"]
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86-native-probe",
      "configurePreset": "windows-x86-native-probe",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
